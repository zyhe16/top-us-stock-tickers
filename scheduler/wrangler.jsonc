{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "top-us-stock-tickers-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "triggers": {
    "crons": ["17 10-14 * * mon-fri"]
  }
}
